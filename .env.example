# ─────────────────────────────────────────────────────────────
# Super Games Arcade — environment variables
#
# Copy this file to .env for local builds. On Vercel, add the same
# keys under Project → Settings → Environment Variables.
#
# PUBLIC_* values are baked into the site at build time and are
# VISIBLE TO ANYONE who opens the site. Never put secrets in them.
# ─────────────────────────────────────────────────────────────

# Name shown in the header, browser tab, and home-screen icon.
PUBLIC_SITE_NAME=Super Games Arcade

# Optional player profiles, so each kid gets their own saves.
# Comma separated, each as Name:emoji. Leave blank to turn profiles off.
# Example: PUBLIC_PLAYERS=Player One:🦄,Player Two:🌈
PUBLIC_PLAYERS=

# Turn on Vercel Web Analytics (also enable it in the Vercel dashboard).
PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# ── Local development only ────────────────────────────────
# Port for `npm run dev`. 4600 avoids the usual 3000/5173/8080 defaults.
PORT=4600

# ── Deploy-only (never exposed to the browser) ───────────────
# Only needed to deploy from your own machine/CI with `npx vercel`.
# Find them in .vercel/project.json after running `npx vercel link`,
# and create a token at https://vercel.com/account/tokens
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
VERCEL_TOKEN=
